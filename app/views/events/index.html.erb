<div class="container">
  <h2>Upcoming Events:</h2>
  <% @upcoming_events.each do |event| %>
    <% if event.open? || event.attendees.include?(current_user) %>
      <ul>
        <li>
          <h3> <%= event.party_title %> </h3>
        </li>
        <li>
          <%= event.date %>
        </li>
        <li>
          <%= event.location %>
        </li>
        <li><%= link_to "Show More", event_path(event) %></li>
      </ul>
    <% end %>
  <% end %>
  <h2>Past Events:</h2>
  <% @past_events.each do |event| %>
    <% if event.open? || event.attendees.include?(current_user) %>
      <ul>
        <li>
          <h3> <%= event.party_title %> </h3>
        </li>
        <li>
          <%= event.date %>
        </li>
        <li>
          <%= event.location %>
        </li>
        <li><%= link_to "Show More", event_path(event) %></li>
      </ul>
    <% end %>
  <% end %>
</div>
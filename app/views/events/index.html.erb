<div class="container">
  <h1>Upcoming Events:</h1>
  <% @events.each do |event| %>
    <ul>
      <li>
        <h2> <%= event.party_title %> </h2>
      </li>
      <li>
        <%= event.date %>
      </li>
      <li>
        <%= event.location %>
      </li>
      <li><%= link_to "Show More", event_path(event) %></li>
    </ul>
  <% end %>
  <%= link_to "Create New Event", new_event_path %>
</div>
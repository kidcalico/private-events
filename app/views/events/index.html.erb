<div class="container">
  <h1>Your Events:</h1>
  <% @events.each do |event| %>
    <% if event.host.id == current_user.id %>
      <ul>
        <li>
          <h2> <%= event.party_title %> </h2>
        </li>
        <li>
          <%= event.date %>
        </li>
        <li>
          <%= event.location %>
        </li>
        <li><%= link_to "Show More", event_path(event) %></li>
      </ul>
    <% end %>
  <% end %>
  <%= link_to "Create New Event", new_event_path %>
  <h1>Other Events:</h1>
  <% @events.each do |event| %>
    <% if event.host.id != current_user.id %>
      <ul>
        <li>
          <h2> <%= event.party_title %> </h2>
        </li>
        <li>
          <%= event.date %>
        </li>
        <li>
          <%= event.location %>
        </li>
        <li><%= link_to "Show More", event_path(event) %></li>
      </ul>
    <% end %>
  <% end %>
</div>
<div class="event">
  <h2>
    <%= @event.party_title %>
  </h2>
  <ul>
    <li>Host: <%= @event.host.username.capitalize %></li>
    <li>Location: <%= @event.location %></li>
    <li>Date: <%= @event.date %></li>
  </ul>
  <p>
    <%= @event.more_info %>
  </p>
  <p>
    Guest List:
    <% @event.invites.each do |invite| %>
      <% if invite.attended_event.id == @event.id %>
        <%= invite.attendee.username %>
      <% end %>
    <% end %>
  </p>
  <% if @event.host == current_user %>
    <%= link_to "Edit Event", edit_event_path(@event) %>
    <%= link_to "Delete Event", event_path(@event), data: { turbo_method: :delete, turbo_confirm: "Are you sure?"} %>
  <% else %>
    <% form_with model: @invite do |form| %>
      <%= form.hidden_field :attended_event_id, value: @event.id %>
      <%= form.hidden_field :rsvp, value: true %>
      <%= form.submit "Send RSVP" %>
    <% end %>
  <% end %>
</div>
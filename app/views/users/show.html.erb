<h1>Events I'm Attending:</h1>
<h2>Upcoming</h2>
<% @attended_events.upcoming.each do |event| %>
  <p>
      <%= event.party_title %><br>
      <%= link_to "Show More", event %>
  </p>
<% end %>
<h2>Past</h2>
<% @attended_events.past.each do |event| %>
  <p>
      <%= event.party_title %><br>
      <%= link_to "Show More", event %>
  </p>
<% end %>

